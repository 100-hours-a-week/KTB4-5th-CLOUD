{
  "family": "dameokja-dev-ai",
  "networkMode": "host",
  "requiresCompatibilities": [
    "EC2"
  ],
  "memory": "1536",
  "executionRoleArn": "arn:aws:iam::906462447513:role/dameokja-dev-ecs-task-execution",
  "taskRoleArn": "arn:aws:iam::906462447513:role/dameokja-dev-ai-task",
  "volumes": [
    {
      "name": "ai-log",
      "host": {
        "sourcePath": "/var/log/dameokja-ai"
      }
    },
    {
      "name": "localtime",
      "host": {
        "sourcePath": "/etc/localtime"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "ai",
      "image": "ghcr.io/100-hours-a-week/ktb4-5th-ai:main",
      "essential": true,
      "repositoryCredentials": {
        "credentialsParameter": "arn:aws:secretsmanager:ap-northeast-2:906462447513:secret:dameokja-v2-dev/ghcr-zDHfef"
      },
      "secrets": [
        {
          "name": "APP_ENV",
          "valueFrom": "/dameokja-v2-dev-ai/APP_ENV"
        },
        {
          "name": "INTERNAL_API_KEY",
          "valueFrom": "/dameokja-v2-dev-ai/INTERNAL_API_KEY"
        },
        {
          "name": "LOG_DIR",
          "valueFrom": "/dameokja-v2-dev-ai/LOG_DIR"
        },
        {
          "name": "LOG_LEVEL",
          "valueFrom": "/dameokja-v2-dev-ai/LOG_LEVEL"
        },
        {
          "name": "LOG_RETENTION_DAYS",
          "valueFrom": "/dameokja-v2-dev-ai/LOG_RETENTION_DAYS"
        },
        {
          "name": "ANALYSIS_QUEUE_MAXSIZE",
          "valueFrom": "/dameokja-v2-dev-ai/ANALYSIS_QUEUE_MAXSIZE"
        },
        {
          "name": "ANALYSIS_RESULT_TTL_SECONDS",
          "valueFrom": "/dameokja-v2-dev-ai/ANALYSIS_RESULT_TTL_SECONDS"
        },
        {
          "name": "ANALYSIS_RESULT_MAX_ENTRIES",
          "valueFrom": "/dameokja-v2-dev-ai/ANALYSIS_RESULT_MAX_ENTRIES"
        },
        {
          "name": "IMAGE_SOURCE",
          "valueFrom": "/dameokja-v2-dev-ai/IMAGE_SOURCE"
        },
        {
          "name": "S3_REGION",
          "valueFrom": "/dameokja-v2-dev-ai/S3_REGION"
        },
        {
          "name": "S3_ALLOWED_PREFIX",
          "valueFrom": "/dameokja-v2-dev-ai/S3_ALLOWED_PREFIX"
        },
        {
          "name": "OLLAMA_MODEL",
          "valueFrom": "/dameokja-v2-dev-ai/OLLAMA_MODEL"
        },
        {
          "name": "CALLBACK_TIMEOUT_SECONDS",
          "valueFrom": "/dameokja-v2-dev-ai/CALLBACK_TIMEOUT_SECONDS"
        },
        {
          "name": "CALLBACK_MAX_ATTEMPTS",
          "valueFrom": "/dameokja-v2-dev-ai/CALLBACK_MAX_ATTEMPTS"
        },
        {
          "name": "S3_BUCKET",
          "valueFrom": "/dameokja-v2-dev-ai/S3_BUCKET"
        },
        {
          "name": "RUNPOD_API_KEY",
          "valueFrom": "/dameokja-v2-dev-ai/RUNPOD_API_KEY"
        },
        {
          "name": "RUNPOD_POD_NAME_PREFIX",
          "valueFrom": "/dameokja-v2-dev-ai/RUNPOD_POD_NAME_PREFIX"
        },
        {
          "name": "RUNPOD_WORKER_PORT",
          "valueFrom": "/dameokja-v2-dev-ai/RUNPOD_WORKER_PORT"
        },
        {
          "name": "TAVILY_API_KEY",
          "valueFrom": "/dameokja-v2-dev-ai/TAVILY_API_KEY"
        },
        {
          "name": "REMOTE_INFERENCE_API_KEY",
          "valueFrom": "/dameokja-v2-dev-ai/REMOTE_INFERENCE_API_KEY"
        },
        {
          "name": "REMOTE_INFERENCE_TIMEOUT_SECONDS",
          "valueFrom": "/dameokja-v2-dev-ai/REMOTE_INFERENCE_TIMEOUT_SECONDS"
        },
        {
          "name": "CALLBACK_URL",
          "valueFrom": "/dameokja-v2-dev-ai/CALLBACK_URL"
        },
        {
          "name": "CALLBACK_API_KEY",
          "valueFrom": "/dameokja-v2-dev-ai/CALLBACK_API_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "/dameokja-v2-dev-ai/DATABASE_URL"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "ai-log",
          "containerPath": "/app/logs"
        },
        {
          "sourceVolume": "localtime",
          "containerPath": "/etc/localtime",
          "readOnly": true
        }
      ]
    }
  ]
}
