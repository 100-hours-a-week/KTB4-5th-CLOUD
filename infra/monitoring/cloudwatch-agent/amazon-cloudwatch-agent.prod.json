{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root",
    "omit_hostname": true
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/dameokja/nginx/access.json.log",
            "log_group_name": "/dameokja/prod/nginx-access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/dameokja/backend.log",
            "log_group_name": "/dameokja/prod/backend",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1,
            "multi_line_start_pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true
      }
    }
  }
}
