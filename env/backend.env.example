# BE 저장소의 APP_ENV에 등록할 BE·DB 통합 환경설정 예시다.
# dev Compose는 데이터소스 주소만 mysql 컨테이너 주소로 덮어쓴다.
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_WITH_DB_PRIVATE_HOST:3306/app
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_APP_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
MYSQL_DATABASE=app
MYSQL_USER=appuser
MYSQL_PASSWORD=REPLACE_WITH_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DEV_ROOT_PASSWORD
