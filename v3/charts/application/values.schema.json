{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "port", "activeColor", "colors", "secretName"],
  "properties": {
    "name": {"enum": ["fe", "be", "ai-api"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "activeColor": {"enum": ["blue", "green"]},
    "allowConcurrentConsumers": {"type": "boolean"},
    "secretName": {"type": "string", "minLength": 1},
    "extraSecretNames": {"type": "array", "items": {"type": "string"}},
    "runAsUser": {"type": "integer", "minimum": 1},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "flywayImage", "unzipImage", "sqlPath", "driverGlob", "baselineOnMigrate", "connectRetries", "timeoutSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "color": {"enum": ["", "blue", "green"]},
        "flywayImage": {"type": "string"},
        "unzipImage": {"type": "string"},
        "sqlPath": {"type": "string", "minLength": 1},
        "driverGlob": {"type": "string", "minLength": 1},
        "baselineOnMigrate": {"type": "boolean"},
        "connectRetries": {"type": "integer", "minimum": 0},
        "timeoutSeconds": {"type": "integer", "minimum": 60},
        "resources": {"type": "object"}
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blue", "green"],
      "properties": {"blue": {"$ref": "#/definitions/color"}, "green": {"$ref": "#/definitions/color"}}
    }
  },
  "definitions": {
    "color": {
      "type": "object", "additionalProperties": false, "required": ["image", "replicas"],
      "properties": {"image": {"type": "string"}, "replicas": {"type": "integer", "minimum": 0, "maximum": 4}}
    }
  }
}
