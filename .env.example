# Replace image references with your GHCR packages and immutable release tags.
FE_IMAGE=ghcr.io/your-owner/dameokja-frontend:release-001
BE_IMAGE=ghcr.io/your-owner/dameokja-backend:release-001

# Replace with the separate DB EC2 private IP or private DNS name.
DB_HOST=db.internal.example
DB_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=appuser
MYSQL_PASSWORD='REPLACE_WITH_APP_PASSWORD'

# Existing Certbot directories on the Ubuntu server; absolute paths also work.
# Mount the full config directory (including live/ and archive/).
LETSENCRYPT_DIR=./certbot/conf
CERTBOT_WEBROOT=./certbot/www
