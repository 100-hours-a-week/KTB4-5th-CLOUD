# 최초 실행 전에 CI가 게시한 실제 Git SHA 태그로 바꾼다.
FE_IMAGE=ghcr.io/100-hours-a-week/ktb4-5th-fe:REPLACE_WITH_GIT_SHA
BE_IMAGE=ghcr.io/100-hours-a-week/ktb4-5th-be:REPLACE_WITH_GIT_SHA

# 서버의 기존 Certbot 경로를 지정한다. 절대 경로도 사용할 수 있다.
# live/와 archive/가 포함된 설정 디렉터리 전체를 마운트한다.
LETSENCRYPT_DIR=./certbot/conf
CERTBOT_WEBROOT=./certbot/www
